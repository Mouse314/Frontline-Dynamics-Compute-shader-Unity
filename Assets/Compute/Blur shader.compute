#pragma kernel CSMain

Texture2D<float4> InputTexture; 
RWTexture2D<float4> OutputTexture; 

float _Time;

[numthreads(8, 8, 1)] 
void CSMain (uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    OutputTexture.GetDimensions(width, height);

    if (id.x >= width || id.y >= height) return;

    float4 color = InputTexture[id.xy];

    float4 leftColor = InputTexture[uint2(max(int(id.x) - 1, 0), id.y)];
    float4 rightColor = InputTexture[uint2(min(id.x + 1, width - 1), id.y)];
    float4 topColor = InputTexture[uint2(id.x, max(int(id.y) - 1, 0))];
    float4 bottomColor = InputTexture[uint2(id.x, min(id.y + 1, height - 1))];

    float4 averageColor = (leftColor + rightColor + topColor + bottomColor) / 4.0;

    OutputTexture[id.xy] = averageColor * 0.4 + color * 0.6; // Apply a simple blur effect with a slight fade
}
